  {
    "metric_key": "waste_rate_per_demand",
    "metric_name": "Waste rate per demand",
    "layer": "marts",
    "source_model": "mart_food_loss_summary",
    "definition": "Total waste quantity divided by the total demand of the same ingredients, on the same days and locations. A ratio of totals, not an average of daily ratios.",
    "numerator": "sum(waste_quantity)",
    "denominator": "sum(ingredient_demand_qty)",
    "unit": "ratio",
    "measurement_type": "derived",
    "trust_states_allowed": [
      "measured"
    ],
    "owner": "ops analytics",
    "caveat": "The denominator covers the ingredients that were wasted, not the whole menu. Published only where a demand denominator exists.",
    "published": true,
    "display_in_dashboard": true
  }
